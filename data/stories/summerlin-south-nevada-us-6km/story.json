  "script": {
    "word_count": 154,
    "est_duration_s": 61.6,
    "segments": [
      {
        "id": "seg-01",
        "chapter_id": "ch-01",
        "text": "This is Summerlin South, Nevada, seen from space by Landsat satellites, one summer at a time from 1984 to 2026. Over these years, the pictures show one lasting change. This film uses 43 summers of Landsat imagery. Each frame shows the same square of ground, 6 kilometres on a side. Each frame combines the clearest days of one summer, between June and September. Clouds and their shadows are removed, and gaps are left empty instead of being filled from other years.",
        "year_from": 1984,
        "year_to": 1990,
        "claim_ids": []
      },
      {
        "id": "seg-02",
        "chapter_id": "ch-02",
        "text": "Between 1991 and 2019, the land across the area turned greener on average, mostly in the east. In all, about 2500 hectares changed. One report says: The first family moved to Summerlin in 1991. One report also says: Summerlin began to take shape in 1990. The change held for eight summers in the record. Compare the 1991 and 2019 frames to see it.",
        "year_from": 1991,
        "year_to": 2019,
        "claim_ids": [
          "cl-01",
          "cl-02"
        ]
      },
      {
        "id": "seg-03",
        "chapter_id": "ch-03",
        "text": "That is how Summerlin South, Nevada has changed since 1984.",
        "year_from": 2020,
        "year_to": 2026,
        "claim_ids": []
      }
    ]
