  "sources": [
    {
      "id": "src-01",
      "url": "http://hdl.handle.net/11166/166927",
      "title": "UCRC: Content of Colorado River Storage Project Reservoirs, Streamflow, and Power Generation",
      "publisher": null,
      "domain": "hdl.handle.net",
      "published_date": "1984-03-14",
      "authority": "other",
      "retrieved_at": "2026-11-15T14:08:52+00:00",
      "excerpts": [
        {
          "id": "ex-01-01",
          "text": "Storage in Lake Mead decreased 323,000 acre-feet during the month. On February 29, 1984, the reservoir contained 24,045,000 acre-feet at water surface elevation 1,207.67 feet (84.67 feet above rated head elevation 1,123 feet.)",
          "verified": true
        }
      ]
    },
    {
      "id": "src-02",
      "url": "https://www.courtlistener.com/opinion/7063966/southwest-center-for-biological-diversity-v-us-bureau-of-reclamation/",
      "title": "Southwest Center for Biological Diversity v. U.S. Bureau of Reclamation, Court of Appeals for the Ninth Circuit, 1998",
      "publisher": null,
      "domain": "courtlistener.com",
      "published_date": "1998-05-04",
      "authority": "other",
      "retrieved_at": "2026-11-15T14:08:52+00:00",
      "excerpts": [
        {
          "id": "ex-02-01",
          "text": "More recently, however, the return of normal rainfall and runoff on the Colorado has caused the water impounded at Lake Mead to rise back to its normal levels, inundating the root crowns of the willows in the delta. Although the willows have shown resiliency to inundation for periods of over 13 months, the extended inundation of the delta has caused a loss of willows and cottonwoods.",
          "verified": true
        }
      ]
    },
    {
      "id": "src-03",
      "url": "https://www.reviewjournal.com/news/drought-stricken-lake-mead-falls-to-a-level-not-seen-since-1937/",
      "title": "Drought-stricken Lake Mead falls to a level not seen since 1937 | News",
      "publisher": null,
      "domain": "reviewjournal.com",
      "published_date": "2010-10-19",
      "authority": "other",
      "retrieved_at": "2026-11-15T14:08:52+00:00",
      "excerpts": [
        {
          "id": "ex-03-01",
          "text": "Since drought took hold on the Colorado and its tributaries in 1999, the surface of Lake Mead has plunged almost 130 feet and caused fits for the National Park Service and its marina operators who must extend roads, utilities and other services to reach the shrinking shoreline.",
          "verified": true
        }
      ]
    },
    {
      "id": "src-04",
      "url": "https://science.nasa.gov/earth/earth-observatory/water-level-changes-in-lake-mead-45945/",
      "title": "Water Level Changes in Lake Mead - NASA Science",
      "publisher": null,
      "domain": "science.nasa.gov",
      "published_date": "2010-09-23",
      "authority": "authoritative",
      "retrieved_at": "2026-11-15T14:08:52+00:00",
      "excerpts": [
        {
          "id": "ex-04-01",
          "text": "In August 2010, Lake Mead reached its lowest level since 1956, the result of a persistent drought and increasing human demand.",
          "verified": true
        }
      ]
    },
    {
      "id": "src-05",
      "url": "https://www.esa.int/articles/about-us/directorates/earth-observation-programmes/earth-from-space-lowering-lake-levels",
      "title": "Earth from Space: Lowering lake levels",
      "publisher": null,
      "domain": "esa.int",
      "published_date": "2010-10-29",
      "authority": "authoritative",
      "retrieved_at": "2026-11-15T14:08:52+00:00",
      "excerpts": [
        {
          "id": "ex-05-01",
          "text": "Its reservoir, Lake Mead, is one of the largest in the world, with a surface area of 593 sq km. However, an 11-year drought and increased water consumption due to population growth have resulted in a decline in its water levels.",
          "verified": true
        }
      ]
    },
    {
      "id": "src-06",
      "url": "https://science.time.com/2010/10/18/water-lake-mead-is-at-record-low-levels-is-the-southwest-drying-up/",
      "title": "Water: Lake Mead Is at Record Low Levels. Is the Southwest Drying Up? | TIME.com",
      "publisher": null,
      "domain": "science.time.com",
      "published_date": "2010-10-18",
      "authority": "other",
      "retrieved_at": "2026-11-15T14:08:52+00:00",
      "excerpts": [
        {
          "id": "ex-06-01",
          "text": "The past decade has seen a precipitous decline in Lake Mead's water levels, as a stubborn, multi-year drought and continued growth in the Southwest have combined to drain the reservoir.",
          "verified": true
        }
      ]
    },
    {
      "id": "src-07",
      "url": "https://bouldercityreview.com/news/lake-mead-hoover-dam/lake-mead-dips-to-lowest-level-in-decades/",
      "title": "Lake Mead dips to lowest level in decades | Boulder City Review",
