  "sources": [
    {
      "id": "src-01",
      "url": "https://science.nasa.gov/earth/earth-observatory/urbanization-of-dubai-38344/",
      "title": "Urbanization of Dubai - NASA Science",
      "publisher": null,
      "domain": "science.nasa.gov",
      "published_date": "2009-04-29",
      "authority": "authoritative",
      "retrieved_at": "2026-11-15T14:15:57+00:00",
      "excerpts": [
        {
          "id": "ex-01-01",
          "text": "The top image, acquired in October 2002, shows the early stages of Palm Jumeirah. The circular outline of the archipelago is largely completed, and the palm fronds are beginning to take shape.",
          "verified": true
        },
        {
          "id": "ex-01-02",
          "text": "The bottom image shows the same region in the same season, but several years later, in November 2008. In this image, Palm Jumeirah sports 17 sandy fronds.",
          "verified": true
        }
      ]
    },
    {
      "id": "src-02",
      "url": "https://www.thenationalnews.com/arts-culture/2024/06/14/dubai-dredging-palm-jumeirah-history/",
      "title": "Timeframe: Dredging Dubai's Palm Jumeirah, one of the world's greatest engineering feats | The National",
      "publisher": null,
      "domain": "thenationalnews.com",
      "published_date": "2024-06-14",
      "authority": "other",
      "retrieved_at": "2026-11-15T14:15:57+00:00",
      "excerpts": [
        {
          "id": "ex-02-01",
          "text": "Extensive landscaping efforts also resulted in the planting of thousands of trees, shrubs and flowers, transforming the Palm Jumeirah into a lush oasis. Parks, gardens and waterfront promenades emerged, inviting residents and visitors to explore and unwind in a serene environment.",
          "verified": true
        }
      ]
    },
    {
      "id": "src-03",
      "url": "https://www.thenationalnews.com/uae/environment/new-park-opens-on-the-palm-jumeirah-in-dubai-1.478455",
      "title": "New park opens on The Palm Jumeirah in Dubai | The National",
      "publisher": null,
      "domain": "thenationalnews.com",
      "published_date": "2012-11-30",
      "authority": "other",
      "retrieved_at": "2026-11-15T14:15:57+00:00",
      "excerpts": [
        {
          "id": "ex-03-01",
          "text": "A new park with more than 60 species of indigenous trees and plants has opened on The Palm Jumeirah. Ittihad Park covers more than 10 hectares and is surrounded by a 3.2 kilometre jogging track.",
          "verified": true
        }
      ]
    }
  ],
