    "segments": [
      {
        "id": "seg-01",
        "chapter_id": "ch-01",
        "text": "This is Delray, Detroit, Michigan, seen from space by Landsat satellites, one summer at a time from 1984 to 2026. In 1984, water covered about 15 percent of the view.",
        "year_from": 1984,
        "year_to": 2009,
        "claim_ids": []
      },
      {
        "id": "seg-02",
        "chapter_id": "ch-02",
        "text": "Between 2010 and 2011, about 4 hectares were cleared or built over in the east. Part of it may come from switching Landsat satellites. The change held for 16 summers in the record. Compare the 2010 and 2011 frames to see it.",
        "year_from": 2010,
        "year_to": 2014,
        "claim_ids": []
      },
      {
        "id": "seg-03",
        "chapter_id": "ch-03",
        "text": "Between 2015 and 2016, about 16 hectares were cleared or built over in the southeast. The change held for ten summers in the record. Compare the 2015 and 2016 frames to see it.",
        "year_from": 2015,
        "year_to": 2018,
        "claim_ids": []
      },
      {
        "id": "seg-04",
        "chapter_id": "ch-04",
        "text": "Between 2019 and 2021, about 28 hectares were cleared or built over in the north. The change held for six summers in the record. Compare the 2019 and 2021 frames to see it.",
        "year_from": 2019,
        "year_to": 2021,
        "claim_ids": []
      },
      {
        "id": "seg-05",
        "chapter_id": "ch-05",
        "text": "By 2026, water covered about 14 percent of the view. That is how Delray, Detroit, Michigan has changed since 1984.",
        "year_from": 2022,
        "year_to": 2026,
        "claim_ids": []
      }
    ]
