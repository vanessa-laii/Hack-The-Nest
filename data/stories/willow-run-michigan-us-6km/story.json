  "sources": [
    {
      "id": "src-01",
      "url": "https://www.mlive.com/news/ann-arbor/2014/10/yankee_air_museum_to_officiall.html",
      "title": "Yankee Air Museum to officially purchase building at former Willow Run Plant Thursday - mlive.com",
      "publisher": null,
      "domain": "mlive.com",
      "published_date": "2014-10-29",
      "authority": "other",
      "retrieved_at": "2026-11-15T14:18:21+00:00",
      "excerpts": [
        {
          "id": "ex-01-01",
          "text": "The runway has been reconstructed thanks to a $40 million commitment from the Federal Aviation Administration and $2 million from the Michigan Department of Transportation. Nearly 50,000 cubic yards of concrete were used to reconstruct the runway along with updates to navigation aids, brighter and more energy efficient lighting and improved drainage. The formal announcements will come at a ceremony being held at the Willow Run Airport Thursday beginning at 11 a.m.",
          "verified": true
        }
      ]
    },
    {
      "id": "src-02",
      "url": "https://www.annarbor.com/business-review/connected-vehicle-research-center-slated-for-former-willow-run-plant/",
      "title": "Connected vehicle research center slated for former Willow Run plant",
      "publisher": null,
      "domain": "annarbor.com",
      "published_date": "2013-09-05",
      "authority": "other",
      "retrieved_at": "2026-11-15T14:18:21+00:00",
      "excerpts": [
        {
          "id": "ex-02-01",
          "text": "The former Willow Run GM Powertrain plant in Ypsilanti Township, pictured here in August, is slated for demolition beginning in October.",
          "verified": true
        }
      ]
    }
  ],
