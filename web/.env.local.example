# Play-only (Vercel / cached films): leave empty so /files and story pages
# use same-origin Next routes + DATA_DIR. No FastAPI required.
NEXT_PUBLIC_API_BASE=

# Optional: point at a running FastAPI for live "Search to build"
# NEXT_PUBLIC_API_BASE=http://localhost:8000

# Server-only — narrate cache hits need no key; key only for first-time TTS
# ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=MFZUKuGQUsGJPQjTS4wC
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Repo-root data/ (relative to web/)
DATA_DIR=../data
