  "script": {
    "word_count": 153,
    "est_duration_s": 61.2,
    "segments": [
      {
        "id": "seg-01",
        "chapter_id": "ch-01",
        "text": "This is Paradise, California, seen from space by Landsat satellites, one summer at a time from 1984 to 2026. Over these years, the pictures show two lasting changes. Between 1985 and 1999, the land across the area turned greener on average, mostly in the northwest. This film uses 43 summers of Landsat imagery. Each frame shows the same square of ground, 6 kilometres on a side.",
        "year_from": 1984,
        "year_to": 2017,
        "claim_ids": []
      },
      {
        "id": "seg-02",
        "chapter_id": "ch-03",
        "text": "Between 2018 and 2020, the land across the area lost its green cover suddenly. In all, about 3100 hectares changed. Records show: In November 2018, the Camp Fire burned into Paradise, California, devastating the town and destroying thousands of structures. Records also show: The Camp Fire left neighborhoods in Paradise with their lush shield of tall pines and landscaping gone. The change held for seven summers in the record. Compare the 2018 and 2020 frames to see it.",
        "year_from": 2018,
        "year_to": 2020,
        "claim_ids": [
          "cl-01",
          "cl-02"
        ]
      },
      {
        "id": "seg-03",
        "chapter_id": "ch-04",
        "text": "That is how Paradise, California has changed since 1984.",
        "year_from": 2021,
        "year_to": 2026,
        "claim_ids": []
      }
    ]
