    "segments": [
      {
        "id": "seg-01", "chapter_id": "ch-01", "year_from": 1984, "year_to": 1999, "claim_ids": [],
        "text": "This is sample narration for a made-up place. In nineteen eighty-four, satellites looked down on a wide blue lake in the desert. For the next fifteen years, summer after summer, the water reached almost the same shoreline, and the land around it barely changed."
      },
      {
        "id": "seg-02", "chapter_id": "ch-02", "year_from": 2000, "year_to": 2014, "claim_ids": ["cl-01"],
        "text": "Then, around two thousand, the water begins to pull back. Year by year a pale ring of dry ground appears where the lake used to be. By two thousand fourteen, about a fifth of this area has turned from water to land. Reports from the time describe the lowest level since the lake was filled, after more than a decade of drought."
      },
      {
        "id": "seg-03", "chapter_id": "ch-03", "year_from": 2009, "year_to": 2011, "claim_ids": [],
        "text": "In the northeast corner, a patch of new ground is cleared between two thousand nine and two thousand eleven. The satellites show the change clearly, but we found no record of why it happened."
      },
      {
        "id": "seg-04", "chapter_id": "ch-04", "year_from": 2015, "year_to": 2024, "claim_ids": [],
        "text": "Since then, the shoreline has crept back a little in the most recent years. The lake remembers every summer. Now you can ask it."
      }
    ]
