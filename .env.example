# Copy to .env and fill in. Never commit .env. See docs/CONTRACTS.md §7.

# --- Shared ---
DATA_DIR=../data

# --- Backend (Harman) ---
EM_MOCK=0
AOI_KM=6
PIPELINE_TIMEOUT_S=180
WEB_ORIGIN=http://localhost:3000
NOMINATIM_USER_AGENT=earth-memory-hackthenest/1.0 (your-email-here)
# Text model for the agent: gemini (default) or openai. Any model is allowed.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# Optional, only if LLM_PROVIDER=openai
OPENAI_API_KEY=
EXA_API_KEY=
# Used for the image check, and for the agent while LLM_PROVIDER=gemini. Set it once.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
MONGODB_URI=

# --- Web, server side only (Vanessa) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# --- Web, public ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
